{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "princesas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build"
  }
}
