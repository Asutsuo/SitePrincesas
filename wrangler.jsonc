{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "princesas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SITE_KV",
      "id": "2fda7a3ce4774dbab46f743ba0132543"
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
